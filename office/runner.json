    "Bash(git status*)", "Bash(git log*)", "Bash(git diff*)", "Bash(git branch*)", "Bash(git remote*)",
    "Bash(git add *)", "Bash(git commit *)", "Bash(git checkout *)", "Bash(git switch *)",
    "Bash(git merge *)", "Bash(git fetch*)", "Bash(git pull*)",
    "Bash(git push origin preview*)", "Bash(git push -u origin feature_*)", "Bash(git push origin feature_*)"
